# ===== 数据库配置 =====
POSTGRES_USER=careerleap
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=careerleap
DATABASE_URL=postgresql://careerleap:请改成强密码@postgres:5432/careerleap

# ===== 后端配置 =====
# 默认 LLM（用户也可在网页设置里覆盖）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SMART_MODEL=gpt-4
FAST_MODEL=gpt-3.5-turbo

# 浏览器访问地址（有域名用域名，没有就用 http://服务器公网IP）
# 走 Nginx 统一入口时不要加 :8000
CORS_ORIGINS=http://你的服务器IP或域名

# ===== 前端配置（构建时写入，必须是浏览器能访问到的地址）=====
# 与上面保持一致，例如 http://1.2.3.4 或 https://interview.example.com
NEXT_PUBLIC_API_URL=http://你的服务器IP或域名
