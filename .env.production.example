# ===== 数据库配置 =====
POSTGRES_USER=careerleap
POSTGRES_PASSWORD=请修改为强密码
POSTGRES_DB=careerleap
DATABASE_URL=postgresql://careerleap:请修改为强密码@postgres:5432/careerleap

# ===== 后端配置 =====
# 默认 LLM API（用户会在前端设置中覆盖）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SMART_MODEL=gpt-4
FAST_MODEL=gpt-3.5-turbo

# ===== 前端配置 =====
# 部署后修改为你的域名或服务器 IP
NEXT_PUBLIC_API_URL=http://localhost:8000
